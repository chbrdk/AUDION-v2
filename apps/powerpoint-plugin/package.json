{
  "name": "@audion/powerpoint-plugin",
  "version": "0.1.0",
  "description": "PowerPoint plugin for chatting with AUDION personas about presentation content",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.399",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.6",
    "office-addin-debugging": "^5.1.0",
    "office-addin-dev-certs": "^2.0.12",
    "office-addin-manifest": "^5.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "5.9.3",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
