{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@udg-glass/types/*": [
        "packages/types/src/*"
      ],
      "@udg-glass/types": [
        "packages/types/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/types/src"
  ]
}

